# StockSense Environment Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=True
ENVIRONMENT=development

# Firebase Admin SDK Configuration (Optional - StockSense automatically runs in Demo Mode if not provided)
FIREBASE_PROJECT_ID=stocksense-fynd-c19
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# CORS Configuration
CORS_ORIGINS=["http://localhost:8000", "http://127.0.0.1:8000", "http://localhost:5500", "http://127.0.0.1:5500", "http://localhost:3000"]
